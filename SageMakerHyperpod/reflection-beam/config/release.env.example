# Copy this file to config/release.env.
# Set only public values documented for the Beam and runtime releases you use.
# Do not add credentials or private registry references.
#
# Runtime support source commits:
#   SGLang: https://github.com/radixark/sglang-reflection-oss/commit/8f94384cb5caeafc57dfa23c52bcfcedf6b88a41
#   vLLM:   https://github.com/Inferact/lin/commit/8e0922e88bf9d4d5c0031f817a4e4749c9ca4ec2
# Set each image to a public digest built from the corresponding release commit.

# Beam JumpStart model IDs by checkpoint variant:
#   BF16:  huggingface-llm-beam-1-0-501b-a23b
#   FP8:   huggingface-llm-beam-1-0-501b-a23b-fp8
#   NVFP4: huggingface-llm-beam-1-0-501b-a23b-nvfp4
JUMPSTART_MODEL_ID=huggingface-llm-beam-1-0-501b-a23b-nvfp4
JUMPSTART_MODEL_VERSION=REPLACE_WITH_PUBLIC_BEAM_JUMPSTART_MODEL_VERSION

# SGLang loads one target checkpoint through HyperPod modelSourceConfig and
# downloads the separate DFlash2 draft checkpoint at runtime.
# Select one target:
#   BF16:  reflection/Beam-1.0-501B-A23B
#   FP8:   reflection/Beam-1.0-501B-A23B-FP8
#   NVFP4: reflection/Beam-1.0-501B-A23B-NVFP4
SGLANG_MODEL_ID=reflection/Beam-1.0-501B-A23B-NVFP4
SGLANG_MODEL_COMMIT_SHA=REPLACE_WITH_FULL_PUBLIC_BEAM_TARGET_COMMIT_SHA
SGLANG_DRAFT_MODEL_ID=reflection/Beam-1.0-501B-A23B-DFlash2
SGLANG_IMAGE=REPLACE_WITH_PUBLIC_SGLANG_IMAGE_AT_SHA256_DIGEST
SGLANG_REASONING_PARSER=beam
SGLANG_TOOL_CALL_PARSER=beam

VLLM_MODEL_ID=REPLACE_WITH_PUBLIC_BEAM_TARGET_MODEL_ID
VLLM_MODEL_COMMIT_SHA=REPLACE_WITH_FULL_PUBLIC_BEAM_TARGET_COMMIT_SHA
VLLM_IMAGE=REPLACE_WITH_PUBLIC_VLLM_IMAGE_AT_SHA256_DIGEST
VLLM_REASONING_PARSER=REPLACE_WITH_DOCUMENTED_BEAM_REASONING_PARSER
VLLM_TOOL_CALL_PARSER=REPLACE_WITH_DOCUMENTED_BEAM_TOOL_CALL_PARSER
