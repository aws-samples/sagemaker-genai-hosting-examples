# Copy this file to config/release.env.
# Set only public values documented for the Beam and runtime releases you use.
# Do not add credentials or private registry references.

# Beam JumpStart model IDs by checkpoint variant:
#   BF16:  huggingface-llm-beam-1-0-501b-a23b
#   FP8:   huggingface-llm-beam-1-0-501b-a23b-fp8
#   NVFP4: huggingface-llm-beam-1-0-501b-a23b-nvfp4
JUMPSTART_MODEL_ID=huggingface-llm-beam-1-0-501b-a23b-nvfp4
JUMPSTART_MODEL_VERSION=REPLACE_WITH_PUBLIC_BEAM_JUMPSTART_MODEL_VERSION

SGLANG_MODEL_ID=REPLACE_WITH_PUBLIC_BEAM_MODEL_ID
SGLANG_MODEL_COMMIT_SHA=REPLACE_WITH_FULL_PUBLIC_BEAM_COMMIT_SHA
SGLANG_IMAGE=REPLACE_WITH_PUBLIC_SGLANG_IMAGE_AT_SHA256_DIGEST
SGLANG_REASONING_PARSER=REPLACE_WITH_DOCUMENTED_BEAM_REASONING_PARSER
SGLANG_TOOL_CALL_PARSER=REPLACE_WITH_DOCUMENTED_BEAM_TOOL_CALL_PARSER

VLLM_MODEL_ID=REPLACE_WITH_PUBLIC_BEAM_MODEL_ID
VLLM_MODEL_COMMIT_SHA=REPLACE_WITH_FULL_PUBLIC_BEAM_COMMIT_SHA
VLLM_IMAGE=REPLACE_WITH_PUBLIC_VLLM_IMAGE_AT_SHA256_DIGEST
VLLM_REASONING_PARSER=REPLACE_WITH_DOCUMENTED_BEAM_REASONING_PARSER
VLLM_TOOL_CALL_PARSER=REPLACE_WITH_DOCUMENTED_BEAM_TOOL_CALL_PARSER
