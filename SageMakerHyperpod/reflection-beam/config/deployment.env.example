# Copy this file to config/deployment.env and set values for your cluster.
# The local .env file is ignored by Git.

BEAM_NAMESPACE=default

JUMPSTART_ENDPOINT_NAME=reflection-beam
JUMPSTART_INSTANCE_TYPE=REPLACE_WITH_SUPPORTED_HYPERPOD_INSTANCE_TYPE

# Launch-guidance examples:
#   B300: NVFP4 or FP8 uses TP4; BF16 uses TP8.
#   H200: FP8 or BF16 uses TP8.
SGLANG_INSTANCE_TYPE=REPLACE_WITH_SUPPORTED_HYPERPOD_INSTANCE_TYPE
SGLANG_GPU_COUNT=REPLACE_WITH_GPU_COUNT
SGLANG_TENSOR_PARALLEL_SIZE=REPLACE_WITH_TENSOR_PARALLEL_SIZE
SGLANG_ATTENTION_BACKEND=trtllm_mha
SGLANG_PAGE_SIZE=64
SGLANG_CONTEXT_LENGTH=1048576
SGLANG_MEM_FRACTION_STATIC=0.85
SGLANG_DFLASH_BLOCK_SIZE=8

VLLM_INSTANCE_TYPE=REPLACE_WITH_SUPPORTED_HYPERPOD_INSTANCE_TYPE
VLLM_GPU_COUNT=REPLACE_WITH_GPU_COUNT
VLLM_TENSOR_PARALLEL_SIZE=REPLACE_WITH_TENSOR_PARALLEL_SIZE
