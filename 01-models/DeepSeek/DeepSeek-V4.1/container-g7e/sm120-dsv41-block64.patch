diff --git a/vllm/utils/flashinfer.py b/vllm/utils/flashinfer.py
index abc4d75..821baee 100644
--- a/vllm/utils/flashinfer.py
+++ b/vllm/utils/flashinfer.py
@@ -417,6 +417,25 @@ def has_flashinfer_sparse_mla_sm120_config(num_q_heads: int, top_k: int) -> bool
     return dispatch is not None and (int(num_q_heads), int(top_k)) in dispatch
 
 
+@functools.cache
+def has_flashinfer_sparse_mla_sm120_runtime_page_size() -> bool:
+    """Return whether FlashInfer's SM120 DSV4 decode accepts any page size.
+
+    FlashInfer <= 0.7.0.post1 instantiates SM120 DSV4 decode only for 64-token
+    pages; flashinfer-ai/flashinfer#5197 (>= 0.7.1) makes the page size a
+    runtime argument and advertises it via ``page_block_size_is_runtime``.
+    (Same probe as vllm-project/vllm#57292.)
+    """
+    if not has_flashinfer_sparse_mla_sm120():
+        return False
+    mod = _get_submodule("flashinfer.mla")
+    get_configs = getattr(mod, "supported_sparse_mla_sm120_configs", None)
+    if get_configs is None:
+        return False
+    config = get_configs().get("dsv4")
+    return bool(getattr(config, "page_block_size_is_runtime", False))
+
+
 @functools.cache
 def has_flashinfer_cutedsl() -> bool:
     """Return ``True`` if FlashInfer cutedsl module is available."""
