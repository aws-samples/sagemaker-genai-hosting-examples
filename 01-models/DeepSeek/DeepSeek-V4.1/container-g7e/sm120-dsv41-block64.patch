-        return [64 if current_platform.is_device_capability_family(90) else 128]
+        # SM90: 64. SM12x: 64 as well -- DeepGEMM's SM120 FP8 paged-MQA logits
+        # accept only 32- or 64-state pages, so a 128-token kernel block would
+        # give ratio-1 indexer pages 128 states. With 64, ratio-1 pages hold 64
+        # states and ratio-2 pages 32 (needs vllm-project/DeepGEMM#14).
+        if current_platform.is_device_capability_family(
+            90
+        ) or current_platform.is_device_capability_family(120):
+            return [64]
+        return [128]
 
 
