     @staticmethod
     def get_supported_kernel_block_sizes(kv_cache_spec=None) -> list[int | MultipleOf]:
+        # SM12x must agree with DeepseekV41IndexerBackend (64): the MLA and
+        # indexer pages share one manager block, so a mismatch fails
+        # select_common_block_size ("No common block size", #59203). The
+        # 64-token block puts ratio-2 compressed pages at 32 tokens, which
+        # FlashInfer's SM120 sparse MLA decodes only with runtime page sizes
+        # (flashinfer-ai/flashinfer#5197, FlashInfer >= 0.7.1).
+        if current_platform.is_device_capability_family(120):
+            return [64]
         return [128]
 
